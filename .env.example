# Network Security AI Agent configuration
# Copy to .env and fill in. Real environment variables override this file.
# .env is git-ignored: it holds secrets (webhook URLs).

# --- Response behavior -------------------------------------------------
# Log what would happen without blocking IPs or sending alerts (default: true)
SOC_DRY_RUN=true
# Automatically block sources of CRITICAL detections (default: false)
SOC_AUTO_BLOCK_CRITICAL=false

# --- Alerting ----------------------------------------------------------
# Must be https:// (http:// only allowed for localhost)
SLACK_WEBHOOK_URL=
# Comma-separated extra webhook URLs (e.g. SIEM ingest)
SOC_WEBHOOK_URLS=
# Minimum seconds between alerts for the same source + attack type (0 = off)
SOC_ALERT_COOLDOWN_SECONDS=300

# --- Blocking ----------------------------------------------------------
# Comma-separated IPs/CIDRs that must never be blocked:
# your gateway, DNS servers, and the IP you manage this machine from
BLOCK_ALLOWLIST=
# Default: /var/lib/network-security-ai-agent/blocklist.txt (root)
#      or ~/.local/state/network-security-ai-agent/blocklist.txt
BLOCKLIST_FILE=

# --- Detection ---------------------------------------------------------
# Model trained with scripts/train_model.py (strongly recommended), e.g.
# models/model.joblib. Without one, every flow is rated LOW until trained.
SOC_MODEL_PATH=
# Optional overrides for the calibrated anomaly-score thresholds
SOC_THRESHOLD_MEDIUM=
SOC_THRESHOLD_HIGH=
SOC_THRESHOLD_CRITICAL=

# --- Logging -----------------------------------------------------------
# DEBUG, INFO, WARNING, ERROR
SOC_LOG_LEVEL=INFO

# --- API server (python -m src.api) ------------------------------------
# 127.0.0.1 = this machine only. Use 0.0.0.0 to accept remote connections
# (only together with an API key and HTTPS; see the README).
SOC_API_HOST=127.0.0.1
SOC_API_PORT=8000
# Largest pcap accepted for upload, in megabytes
SOC_MAX_UPLOAD_MB=500

# API key (32+ chars). Required when SOC_API_HOST is not 127.0.0.1.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Clients send it as `Authorization: Bearer <key>`.
# Keep it server-side: put it in your Vercel project's environment variables,
# never in browser code (anything shipped to the browser is public).
SOC_API_KEY=
# Browser origins allowed to call the API directly (comma-separated, exact),
# e.g. http://localhost:3000 for local UI development. Not needed when the
# Vercel app calls the API from its server routes.
SOC_CORS_ORIGINS=
# Optional regex for preview deployments, e.g.
# ^https://my-dashboard(-[a-z0-9-]+)?\.vercel\.app$
SOC_CORS_ORIGIN_REGEX=
