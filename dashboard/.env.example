# SOC Dashboard configuration
# Local development: copy to .env.local (git-ignored) and fill in.
# Vercel: set these in Project Settings -> Environment Variables.
#
# NEVER prefix these with NEXT_PUBLIC_: that would copy them into the
# JavaScript sent to every visitor's browser.

# Base URL of the sensor's API (python -m src.api).
# Must be https:// in production; http:// is allowed only for localhost.
SOC_API_URL=http://127.0.0.1:8000

# Must match SOC_API_KEY on the sensor (32+ characters).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
SOC_API_KEY=

# Optional: timeout for each request to the sensor, in milliseconds
# (default 30000). Pcap analysis can take longer; uploads use their own limit.
SOC_API_TIMEOUT_MS=

# Optional: largest pcap the dashboard accepts for upload, in MB (default 4).
# Vercel limits function request bodies to about 4.5 MB, so keep this at 4
# there. Self-hosted dashboards can raise it.
DASHBOARD_MAX_UPLOAD_MB=
